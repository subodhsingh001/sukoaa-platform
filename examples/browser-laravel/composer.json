{
  "name": "sukoaa/laravel-learning-starter",
  "type": "project",
  "require": {
    "php": "^8.3",
    "laravel/framework": "13.42.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "platform": {
      "php": "8.3.33"
    },
    "allow-plugins": false
  }
}