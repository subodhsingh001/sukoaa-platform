# Local browser tools do not require credentials. Never commit .env.local.
APP_ORIGIN=http://localhost:3000
# Public canonical production origin (set to https://www.sukoaa.com in Vercel).
SITE_URL=
SITE_INDEXING_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Publish only real inboxes you monitor. These addresses are shown publicly.
SUPPORT_EMAIL=
SECURITY_EMAIL=
# Optional publisher release page. Installers need version + verified SHA256 metadata.
BROWSER_RELEASE_URL=
# Optional isolated runner; never execute untrusted code on the website host.
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
# Provider-specific environment and language IDs are described in setup documents.
