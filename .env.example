# Copy this file to .env.local. Never commit .env.local.
# No credentials are needed for the browser playgrounds.
# In production replace localhost with your exact HTTPS website origin and redeploy.
APP_ORIGIN=http://localhost:3000

# Server-side only. Supabase Project settings → API / Connect.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional locally; REQUIRED for protected actions in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: only set to an IP header your HOST overwrites, never a user-controlled header.
# Vercel: verify current platform behavior for x-vercel-forwarded-for before enabling.
# Cloudflare directly: cf-connecting-ip (only when traffic cannot bypass that proxy).
# Blank uses a shared anonymous auth bucket, intentionally conservative.
TRUSTED_CLIENT_IP_HEADER=

# Go (and optional Python API): isolated Judge0 service. Browser Python needs no runner. Never execute untrusted code on the web host.
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
# For a RapidAPI Judge0 provider, use its key instead of X-Auth-Token:
JUDGE0_RAPIDAPI_KEY=
# Query YOUR runner /languages and choose its installed Python and Go IDs.
JUDGE0_PYTHON_ID=
JUDGE0_GO_ID=

# AI is hard-disabled in code. No OPENAI_API_KEY is requested or used.

# Project Studio browser Node runtime. Prototypes/POCs can use prototype mode.
# Set disabled to turn it off, or licensed with a provider-issued commercial API key.
# This key is intentionally browser-visible; never put a server secret here.
NEXT_PUBLIC_WEBCONTAINER_MODE=prototype
NEXT_PUBLIC_WEBCONTAINER_API_KEY=

# Public canonical URL (usually the same as APP_ORIGIN). No trailing slash.
SITE_URL=
# Set true only for your public production site. Preview deployments stay noindex.
SITE_INDEXING_ENABLED=false
# Optional Search Console HTML-tag verification token; not the full HTML tag.
GOOGLE_SITE_VERIFICATION=
# Public support contact displayed in the website privacy summary.
SUPPORT_EMAIL=
# Paste published Chrome Web Store detail URLs only, after the listings are live.
CHROME_STORE_QUICK_REPLIES_URL=
CHROME_STORE_WEB_PDF_STUDIO_URL=

# Optional: public GitHub RELEASE PAGE (not a draft, source file or private repo).
# Example format: https://github.com/OWNER/REPO/releases/tag/TAG
# Adds a View GitHub release button to /browser and /downloads.
# For direct installer buttons with checksums, use the admin release manager instead.
BROWSER_RELEASE_URL=
